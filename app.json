{
  "expo": {
    "name": "SmartDress",
    "slug": "smartdress",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FCFFFF",
    "newArchEnabled": false,
    "android": { "package": "com.smartdress.app", "versionCode": 1 },
    "plugins": [
      ["react-native-ble-plx", {
        "isBackgroundEnabled": false,
        "neverForLocation": true,
        "bluetoothAlwaysPermission": "SmartDress utilise le Bluetooth pour communiquer avec la machine."
      }]
    ]
  }
}
